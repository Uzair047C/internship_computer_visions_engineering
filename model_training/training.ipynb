   "source": [
    "# --- Path setup ---\n",
    "output_dir = os.path.join(\"..\", \"data_set_generator_for_cnns_only\", \"data_set\", \"test\")\n",
    "output_dir = os.path.abspath(output_dir)\n",
    "\n",
    "os.makedirs(output_dir, exist_ok=True)\n",
    "\n",
    "for img_idx, result in enumerate(pred):\n",
    "    boxes = result.boxes.xyxy.cpu().numpy().astype(int)\n",
    "    source_img = result.orig_img\n",
    "\n",
    "    # Get image name\n",
    "    src_path = getattr(result, \"path\", None)\n",
    "    stem = os.path.splitext(os.path.basename(src_path))[0] if src_path else f\"image{img_idx}\"\n",
    "\n",
    "    # -----------------------------\n",
    "    # No detections -> Save original image\n",
    "    # -----------------------------\n",
    "    if len(boxes) == 0:\n",
    "        original_rgb = cv2.cvtColor(source_img, cv2.COLOR_BGR2RGB)\n",
    "        img = Image.fromarray(original_rgb)\n",
    "\n",
    "        save_path = os.path.join(output_dir, f\"{stem}_no_detection.png\")\n",
    "        img.save(save_path)\n",
    "\n",
    "        print(f\"{stem}: No bounding boxes found. Saved original image.\")\n",
    "        continue\n",
    "\n",
    "    # -----------------------------\n",
    "    # Save each detected crop\n",
    "    # -----------------------------\n",
    "    for box_idx, (x1, y1, x2, y2) in enumerate(boxes):\n",
    "        crop = source_img[y1:y2, x1:x2]\n",
    "\n",
    "        if crop.size == 0:\n",
    "            print(f\"{stem} box {box_idx}: Empty crop, skipping.\")\n",
    "            continue\n",
    "\n",
    "        crop_rgb = cv2.cvtColor(crop, cv2.COLOR_BGR2RGB)\n",
    "        img = Image.fromarray(crop_rgb)\n",
    "\n",
    "        save_path = os.path.join(output_dir, f\"{stem}_crop_{box_idx}.png\")\n",
    "        img.save(save_path)\n",
    "\n",
    "        print(f\"Saved {save_path}\")"
   ]
  },
